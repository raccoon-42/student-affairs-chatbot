# Copy to .env and fill in. Everything has a sane default except the API key.
OPENROUTER_API_KEY=your-openrouter-api-key

# --- LLM ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# ALLOWED_CHAT_MODELS=anthropic/claude-haiku-5.5,anthropic/claude-sonnet-5.5   # model_name values the API accepts
# JUDGE_MODEL=anthropic/claude-sonnet-5.5
# GUARD_MODEL=anthropic/claude-haiku-5.5                                       # scope gate, rewrite, chat titles
# IMAGE_MODEL=anthropic/claude-sonnet-5.5                                      # reads attached images into a question
# PARSER_MODEL=anthropic/claude-sonnet-5.5                                     # corpus parsers (preprocessing/parsers)
# PARSER_MAX_TOKENS=64000
# REASONING_OFF_MODELS=anthropic/claude-haiku-5.5                              # thinking off (latency); never Sonnet 5.5: it 400s
# LLM_MAX_TOKENS=8192                                                          # covers thinking + answer
# LLM_CONTEXT_WINDOW=1000000                                                   # for the UI context-fill %
# LLM_TIMEOUT_SECONDS=90

# --- Embeddings ---
# OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2

# --- Qdrant collections ---
# QDRANT_URL=http://localhost:6333
# CALENDAR_COLLECTION=calendar
# REGULATIONS_COLLECTION=regulations
# FAQ_COLLECTION=faq
# FORMS_COLLECTION=forms
# SKS_COLLECTION=sks
# PROGRAMS_COLLECTION=programs
# PEOPLE_COLLECTION=people
# COURSES_COLLECTION=courses
# GUIDES_COLLECTION=guides

# --- Speech-to-text (mic button hidden when unset) ---
# GROQ_API_KEY=your-groq-api-key
# GROQ_WHISPER_MODEL=whisper-large-v3

# --- Auth / persistence ---
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com   # enables Google Sign-In in the web UI
# ADMIN_EMAILS=you@gmail.com                        # may read /admin/usage; empty disables it
# DB_PATH=data/app.db
# COOKIE_SECURE=1                                   # set behind HTTPS in production

# --- Rate limits / abuse ---
# CHAT_LIMIT_ANON=5
# CHAT_LIMIT_USER=60
# STT_LIMIT=30
# IMPORT_LIMIT=5                                    # conversation imports per hour
# IMPORT_MAX_MB=50                                  # stored messages before imports stop
# CHAT_REFUSAL_LIMIT=3
# ABUSE_BLOCK_MINUTES=10
# ABUSE_EXEMPT=127.0.0.1,you@gmail.com              # dev bypass for the abuse block only
# RATELIMIT_EXEMPT=127.0.0.1,you@gmail.com          # dev bypass for chat/STT limits

# --- Frontend ---
# API_URL=http://localhost:8000
